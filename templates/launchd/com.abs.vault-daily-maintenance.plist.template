<?xml version="1.0" encoding="UTF-8"?>
<!--
  com.abs.vault-daily-maintenance.plist.template

  macOS launchd template for ai-brain-starter's daily vault maintenance.

  Runs scripts/vault-daily-maintenance.sh once a day at 04:30 local time, at low
  CPU + IO priority, so the heavy hygiene scripts (drift-detection,
  check-rule-conflicts, passive-capture) and the deferred-close reconciliation
  never run on the interactive session-close path. The script is itself
  load-gated + mutex-serialized, so a 04:30 run on a busy machine cleanly defers
  to the next day instead of piling on.

  Replace the three placeholders below with absolute paths on your machine, then
  drop the rendered file at ~/Library/LaunchAgents/ and load with `launchctl`.
  The install script at scripts/install-vault-daily-maintenance.sh does both
  substitution and load in one step.

  Placeholders:
    {{REPO_ROOT}}    absolute path to the ai-brain-starter clone
                     example: /Users/me/Desktop/ai-brain-starter
    {{VAULT_ROOT}}   absolute path to your Obsidian vault
                     example: /Users/me/Documents/MyVault
    {{LOG_DIR}}      absolute directory for stdout/stderr logs
                     example: /Users/me/.local/state/ai-brain-starter
    {{SKIP_STEPS}}   comma-separated step labels to turn off (may be empty);
                     the installer fills it from ABS_SKIP_STEPS
                     example: drift-detection,check-rule-conflicts
    {{RECONCILE_EXTRA_PATHS}}  more vault-relative paths the nightly sweep
                     commits, colon-separated (may be empty); filled from
                     ABS_RECONCILE_EXTRA_PATHS. example: Meta/Agent Memory
    {{RECONCILE_PUSH}}  1 to push after the sweep commits, empty or 0 not to;
                     filled from ABS_RECONCILE_PUSH

  After the file lands at ~/Library/LaunchAgents/, run:
    launchctl load ~/Library/LaunchAgents/com.abs.vault-daily-maintenance.plist
  Stop with:
    launchctl unload ~/Library/LaunchAgents/com.abs.vault-daily-maintenance.plist

  Linux users: there is no launchd. Use cron instead (XML forbids a double
  dash inside a comment, so the vault-root flag is written in its env form) -
    30 4 * * *  VAULT_ROOT={{VAULT_ROOT}} /bin/bash {{REPO_ROOT}}/scripts/vault-daily-maintenance.sh >> {{LOG_DIR}}/vault-daily-maintenance.out.log 2>&1
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.abs.vault-daily-maintenance</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>{{REPO_ROOT}}/scripts/vault-daily-maintenance.sh</string>
        <string>--vault-root</string>
        <string>{{VAULT_ROOT}}</string>
    </array>

    <!-- launchd hands a job a minimal PATH (/usr/bin:/bin:/usr/sbin:/sbin) with
         no Homebrew prefix, so anything this script shells out to that was
         installed via brew (gh, uv, node, a brew git...) fails with "not
         found" here even though it works in every interactive shell. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/home/linuxbrew/.linuxbrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <!-- Steps to skip, comma-separated; filled from ABS_SKIP_STEPS at install time. -->
        <key>ABS_SKIP_STEPS</key>
        <string>{{SKIP_STEPS}}</string>
        <!-- Extra paths for the nightly commit, and whether to push; see the header. -->
        <key>ABS_RECONCILE_EXTRA_PATHS</key>
        <string>{{RECONCILE_EXTRA_PATHS}}</string>
        <key>ABS_RECONCILE_PUSH</key>
        <string>{{RECONCILE_PUSH}}</string>
    </dict>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>Nice</key>
    <integer>10</integer>

    <key>ProcessType</key>
    <string>Background</string>

    <key>LowPriorityIO</key>
    <true/>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>{{LOG_DIR}}/vault-daily-maintenance.out.log</string>

    <key>StandardErrorPath</key>
    <string>{{LOG_DIR}}/vault-daily-maintenance.err.log</string>
</dict>
</plist>
